APP_NAME=Caterly
APP_ENV=production
APP_KEY=base64:GENERATE_A_UNIQUE_KEY
APP_DEBUG=false
APP_URL=https://caterly.akbaralfaidah.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_COOLIFY_MARIADB_HOST
DB_PORT=3306
DB_DATABASE=caterly
DB_USERNAME=caterly
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=caterly.akbaralfaidah.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@akbaralfaidah.com
MAIL_FROM_NAME=Caterly

RUN_MIGRATIONS=true
VITE_APP_NAME=Caterly
